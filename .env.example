# ---------------------------------------------------------------------------
# Ultron Core — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Lead delivery (contact form)
# The contact form is NOT production-ready until a provider is configured.
# Supported initial provider: generic transactional email (e.g. Resend-style API).
# ---------------------------------------------------------------------------

# Provider selector: "console" (dev only, logs metadata — never message body) or "email"
LEAD_PROVIDER=console

# Email provider API key (required when LEAD_PROVIDER=email)
LEAD_EMAIL_API_KEY=

# Verified sender address (must be verified with your email provider)
LEAD_EMAIL_FROM=

# Destination address that receives lead notifications
LEAD_EMAIL_TO=

# ---------------------------------------------------------------------------
# Optional business details (left blank => hidden on the site, never shown as placeholders)
# Prefer setting these in src/config/site.ts; env is available for deploy-time overrides.
# ---------------------------------------------------------------------------

# Confirmed booking URL (e.g. Calendly). Blank => "Book a Free Intro Call" routes to /contact.
NEXT_PUBLIC_BOOKING_URL=

# Privacy-conscious analytics (blank => analytics disabled; no events recorded)
NEXT_PUBLIC_ANALYTICS_DOMAIN=
